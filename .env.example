APP_NAME="Agent Host"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3116

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agent_host
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1900

AGY_BIN=agy

# Login password: php artisan agenthost:hash-password (keep the single quotes)
AGENT_HOST_PASSWORD_HASH=
